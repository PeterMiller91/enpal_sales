# Baubarkeits-Check – Apache (Netcup Webhosting / Plesk)

Options -Indexes

# Konfiguration, Bibliothek und interne Dateien nie ausliefern
<FilesMatch "^(config(\.sample)?\.php|\.user\.ini|README\.md|\.git.*)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 ^/(lib|daten|\.git)(/|$)
RedirectMatch 301 ^/wirtschaf(t)?lichkeit$ /wirtschaftlichkeit/
RedirectMatch 301 ^/wirtschaflichkeit/(.*)$ /wirtschaftlichkeit/$1

# HTTPS erzwingen (Zertifikat z. B. über Let's Encrypt in Plesk)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    <FilesMatch "^(index\.html|sw\.js|app\.js|db\.js|styles\.css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
